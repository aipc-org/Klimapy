[package]
name = "bufrw"
version = "0.2.0"
edition = "2024"
license = "MIT"
description = "This crate provides a single adapter that buffers reads and writes on the same stream"
readme = "Readme.md"
repository = "https://github.com/tmontaigu/bufrw"

[dev-dependencies]
criterion = { version = "0.7.0", features = ["html_reports"] }
rand = "0.9.2"

[[bench]]
name = "benches"
harness = false